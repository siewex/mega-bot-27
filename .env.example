# ===== Обязательное =====
# Токен от @BotFather
BOT_TOKEN=
# Ключ от shprotoness-ai
API_KEY=

# ===== API и модель =====
API_BASE_URL=https://shprotoness-ai.jq9gfk.workers.dev/v1
# ID модели точно как в таблице (проверить: python check_api.py)
MODEL=grok-4.5
# Запасная модель, если основная не ответила (пусто = без запасной)
FALLBACK_MODEL=deepseek-v4-flash
# low / medium / high — для чат-бота хватает low (быстрее и дешевле). Пусто = не передавать
REASONING_EFFORT=low
# 0.0–1.0, чем выше — тем «живее» речь. none = не передавать
TEMPERATURE=0.8
MAX_TOKENS=1500
REQUEST_TIMEOUT=90

# ===== Лига =====
BOT_NAME=MEGA-бот
# Кого предлагать, когда бот не знает ответа
COMMISSIONERS=@commish1, @commish2
# Telegram user_id админов через запятую (узнать: команда /id). Админам доступны /reload и /status, без лимитов
ADMIN_IDS=
# chat_id группы лиги (узнать: /id в группе). Пусто = бот работает в любой группе, куда добавлен
ALLOWED_CHAT_IDS=
# Отвечать ли в личных сообщениях (1/0)
ALLOW_PRIVATE=1
# Слова, на которые бот откликается без тега (нужно отключить Group Privacy в BotFather). Пусто = только тег/reply
TRIGGER_WORDS=
# Ссылка на полный регламент для /rules (необязательно)
RULES_URL=

# ===== Лимиты =====
COOLDOWN_SECONDS=5
DAILY_LIMIT=40
MAX_CONCURRENT=4
HISTORY_LIMIT=14
HISTORY_TTL_DAYS=14
